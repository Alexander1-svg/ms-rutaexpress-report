# Copiar como .env (ignorado por Git) solo si necesitas cambiar los valores por defecto.

# Por defecto usa los nombres internos de la red Docker "rutaexpress-kafka", que
# funcionan cuando este servicio corre en la MISMA máquina que los brokers.
# KAFKA_BOOTSTRAP_SERVERS=kafka-1:29092,kafka-2:29092,kafka-3:29092

# 127.0.0.1 = la API solo responde en la misma máquina. 0.0.0.0 si otra EC2 debe consultarla.
KAFKA_ANALYTICS_BIND_ADDRESS=127.0.0.1
