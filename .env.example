# Copiar como .env (ignorado por Git) y completar. No subas el .env ni el wallet al repositorio.

# --- Oracle (los mismos valores que usa Shipments) -----------------------------
# El alias (rutaexpress_medium) debe existir en el tnsnames.ora del wallet.
DB_URL=jdbc:oracle:thin:@rutaexpress_medium?TNS_ADMIN=/opt/oracle/wallet
DB_USERNAME=
DB_PASSWORD=
# Carpeta del wallet extraído (no el ZIP). Por defecto ./wallet junto a este archivo.
# ORACLE_WALLET_DIR=./wallet
# update = Hibernate crea la tabla si falta. validate = la tabla ya la creó el DBA.
# JPA_DDL_AUTO=update

# --- Kafka ---------------------------------------------------------------------
# Por defecto usa los nombres internos de la red Docker "rutaexpress-kafka", que
# funcionan cuando este servicio corre en la MISMA máquina que los brokers.
# KAFKA_BOOTSTRAP_SERVERS=kafka-1:29092,kafka-2:29092,kafka-3:29092

# 127.0.0.1 = la API solo responde en la misma máquina. 0.0.0.0 si otra EC2 debe consultarla.
KAFKA_ANALYTICS_BIND_ADDRESS=127.0.0.1
